---
import Header from "../components/Header.astro";
import BottomPill from "../components/BottomPill.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  namespace?: string;
}

const {
  title = "9.63",
  description = "New York based global design agency.",
  namespace = "home",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body data-barba="wrapper">
    <Header />
    <div
      class="audio-playing-line"
      id="audio-playing-line"
      aria-hidden="true"
    ></div>

    <main
      id="main-content"
      data-barba="container"
      data-barba-namespace={namespace}
    >
      <slot />
    </main>

    <BottomPill />

    <style>
      .audio-playing-line {
        display: none;
        position: fixed;
        top: 0;
        bottom: 0;
        left: 30%;
        width: 1px;
        background-color: var(--color-red);
        pointer-events: none;
        z-index: 9999;
      }

      .audio-playing-line.is-playing {
        display: block;
      }
    </style>

    <script>
      import { initPageTransitions } from "../scripts/motion";

      if (typeof window !== "undefined") {
        initPageTransitions();
      }
    </script>
  </body>
</html>
