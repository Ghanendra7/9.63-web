---
import type { Project, ProjectImage } from "../types/project";
import { urlFor } from "../lib/sanity";

interface Props {
  project: Project;
  index: number;
  totalProjects?: number;
}

const { project, index, totalProjects = 16 } = Astro.props;

const SIZES = ["small", "large", "medium", "small", "medium", "large"] as const;
const sizeVariant = SIZES[index % SIZES.length];

// Extract all images
const rawImages: ProjectImage[] =
  project.images && project.images.length > 0
    ? project.images
    : ([project.coverImage, ...(project.gallery || [])].filter(
        Boolean,
      ) as ProjectImage[]);

const images: ProjectImage[] =
  rawImages.length > 0
    ? rawImages
    : [
        {
          asset: { url: `/placeholders/pd${(index % 8) + 1}.png` },
          alt: project.title,
        },
      ];

const hasMultipleImages = images.length > 1;

const projectOrder = index + 1;
const projectNum = String(projectOrder).padStart(2, "0");
const projectFraction = `${projectOrder}/${totalProjects}`;
const slug =
  (typeof project.slug === "object" ? project.slug?.current : project.slug) ||
  `project-${projectNum}`;
---

<article
  class={`project-card size-${sizeVariant} ${project.comingSoon ? "is-coming-soon" : ""}`}
  data-project-id={project._id}
  data-index={index}
  aria-label={`Project ${projectNum}: ${project.title} — ${project.client || ""}`}
>
  <div class="card-inner">
    <div class="card-left-meta" aria-hidden="true">
      <span class="slide-count">{projectFraction}</span>
    </div>

    <div
      class="card-media-wrapper"
      data-project-media
      data-total-slides={images.length}
    >
      <div class="media-link">
        <div class="media-container">
          {images.map((img, imgIndex) => {
            const hasAsset = Boolean(img.asset?._id || img.asset?._ref);
            const imgUrl = hasAsset
              ? urlFor(img).width(1200).auto("format").url()
              : img.asset?.url || "";

            const focalX =
              img.hotspot?.x != null ? Math.round(img.hotspot.x * 100) : 50;
            const focalY =
              img.hotspot?.y != null ? Math.round(img.hotspot.y * 100) : 50;
            const objectPosition = `${focalX}% ${focalY}%`;

            return (
              <img
                src={imgUrl}
                alt={img.alt || `${project.title} slide ${imgIndex + 1}`}
                class={`media-image slide-image ${imgIndex === 0 ? "is-active" : ""}`}
                data-slide-index={imgIndex}
                style={`object-position: ${objectPosition};`}
                loading={index < 2 && imgIndex === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            );
          })}

          {project.comingSoon && (
            <div class="coming-soon-badge" aria-label="Coming Soon">
              <span>Coming Soon</span>
            </div>
          )}

          {hasMultipleImages && (
            <div
              class="media-dots-indicator"
              aria-label="Project images navigation"
            >
              {images.map((_, dotIndex) => (
                <button
                  type="button"
                  class={`indicator-dot ${dotIndex === 0 ? "is-active" : ""}`}
                  data-dot-index={dotIndex}
                  aria-label={`Go to slide ${dotIndex + 1} of ${images.length}`}
                />
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    <div class="card-info">
      <div class="info-pill-group">
        <div class="index-pill" aria-hidden="true">
          <span>{projectNum}</span>
        </div>
        <div class="title-group">
          <div class="title-link">
            <span class="project-title">{project.title}</span>
            {project.client && (
              <span class="project-client">{project.client}</span>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    --card-media-width: 207px;
    width: 100%;
    margin-bottom: 4px;
    position: relative;
    z-index: 1;
  }

  .project-card:hover,
  .project-card:focus-within {
    z-index: 2;
  }

  .size-small {
    --card-media-width: 207px;
  }

  .size-medium {
    --card-media-width: 419px;
  }

  .size-large {
    --card-media-width: 628px;
  }

  .card-inner {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 20px;
    width: 100%;
  }

  .card-left-meta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 6px;
    flex-shrink: 0;
    width: 42px;
  }

  .slide-count {
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-primary);
    white-space: nowrap;
    user-select: none;
  }

  .card-media-wrapper {
    position: relative;
    border-radius: var(--radius-card);
    flex-shrink: 0;
    width: var(--card-media-width);
    aspect-ratio: 3 / 4;
    transition: width 0.5s var(--ease-expo);
    will-change: width;
    touch-action: pan-y;
  }

  .card-media-wrapper:hover,
  .card-media-wrapper:focus-within {
    width: calc(var(--card-media-width) * 1.2);
  }

  .media-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    border-radius: var(--radius-card);
    overflow: hidden;
    touch-action: pan-y;
  }

  .media-container {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: rgba(240, 240, 240, 0.4);
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    touch-action: pan-y;
  }

  .media-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-card);
    opacity: 0;
    transition: opacity 0.4s var(--ease-nav);
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .media-image.is-active {
    opacity: 1;
    z-index: 2;
  }

  .coming-soon-badge {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 3;
    height: 30px;
    padding: 0 10px;
    border-radius: var(--radius-pill-sm);
    background-color: var(--color-pill-frame);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .coming-soon-badge span {
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: rgba(0, 0, 0, 0.25);
    white-space: nowrap;
  }

  .media-dots-indicator {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 10px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .indicator-dot {
    width: 10.5px;
    height: 10.5px;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: #828282;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.25s ease;
    pointer-events: auto;
  }

  .indicator-dot.is-active {
    background-color: #bcbcbc;
  }

  .card-info {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding-bottom: 2px;
  }

  .info-pill-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .index-pill {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-pill-sm);
    background-color: var(--color-pill-frame);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-muted);
    user-select: none;
    flex-shrink: 0;
  }

  .title-group {
    display: flex;
    align-items: center;
  }

  .title-link {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    white-space: nowrap;
  }

  .project-title {
    color: var(--color-text-primary);
    transition: color 0.2s ease;
  }

  .project-client {
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .title-link:hover .project-title {
    color: #444444;
  }

  @media (max-width: 900px) {
    .size-small,
    .size-medium,
    .size-large {
      --card-media-width: 480px;
    }

    .card-media-wrapper {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .project-card {
      margin-bottom: 10px;
    }

    .card-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 5px;
    }

    .card-left-meta {
      display: none;
    }

    .size-small {
      --card-media-width: 108px;
    }

    .size-medium {
      --card-media-width: 218px;
    }

    .size-large {
      --card-media-width: 380px;
    }

    .card-media-wrapper {
      max-width: 100%;
    }

    .index-pill {
      width: 25px;
      height: 25px;
      border-radius: 12px;
      font-size: var(--text-size);
    }

    .title-link {
      font-size: var(--text-size);
      gap: 5px;
    }

    .project-title,
    .project-client {
      font-size: var(--text-size);
      letter-spacing: var(--text-tracking);
    }

    .coming-soon-badge span {
      font-size: var(--text-size);
    }
  }
</style>

<script>
  function initProjectGalleries() {
    const wrappers = document.querySelectorAll<HTMLElement>(
      "[data-project-media]",
    );

    wrappers.forEach((wrapper) => {
      if ((wrapper as any).__galleryInit) return;
      (wrapper as any).__galleryInit = true;

      const slides = wrapper.querySelectorAll<HTMLElement>(".slide-image");
      const dots =
        wrapper.querySelectorAll<HTMLButtonElement>(".indicator-dot");
      const total = slides.length;
      if (total <= 1) return;

      let currentIdx = 0;

      function setSlide(idx: number) {
        currentIdx = idx;
        slides.forEach((slide, i) => {
          if (i === idx) {
            slide.classList.add("is-active");
          } else {
            slide.classList.remove("is-active");
          }
        });
        dots.forEach((dot, i) => {
          if (i === idx) {
            dot.classList.add("is-active");
          } else {
            dot.classList.remove("is-active");
          }
        });
      }

      dots.forEach((dot) => {
        const dotIdx = Number(dot.dataset.dotIndex ?? 0);

        dot.addEventListener("mouseenter", (e) => {
          e.stopPropagation();
          setSlide(dotIdx);
        });

        dot.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          setSlide(dotIdx);
        });
      });

      // Desktop: Reset slide on mouse leave if device supports hover
      wrapper.addEventListener("mouseleave", () => {
        if (window.matchMedia("(hover: hover)").matches) {
          setSlide(0);
        }
      });

      // Touch: Swipe left/right to navigate images
      let touchStartX = 0;
      let touchStartY = 0;
      let touchEndX = 0;
      let touchEndY = 0;
      let isSwiping = false;

      wrapper.addEventListener(
        "touchstart",
        (e: TouchEvent) => {
          if (e.touches.length !== 1) return;
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          touchEndX = touchStartX;
          touchEndY = touchStartY;
          isSwiping = false;
        },
        { passive: true },
      );

      wrapper.addEventListener(
        "touchmove",
        (e: TouchEvent) => {
          if (e.touches.length !== 1) return;
          touchEndX = e.touches[0].clientX;
          touchEndY = e.touches[0].clientY;
          const diffX = touchEndX - touchStartX;
          const diffY = touchEndY - touchStartY;

          // Flag as swiping if horizontal intent is clear
          if (Math.abs(diffX) > 10 && Math.abs(diffX) > Math.abs(diffY)) {
            isSwiping = true;
          }
        },
        { passive: true },
      );

      wrapper.addEventListener(
        "touchend",
        () => {
          if (!isSwiping) return;

          const diffX = touchEndX - touchStartX;
          const diffY = touchEndY - touchStartY;
          const minSwipeDistance = 30; // px threshold

          if (
            Math.abs(diffX) > minSwipeDistance &&
            Math.abs(diffX) > Math.abs(diffY)
          ) {
            if (diffX < 0) {
              // Swipe left -> next image
              setSlide(Math.min(total - 1, currentIdx + 1));
            } else {
              // Swipe right -> previous image
              setSlide(Math.max(0, currentIdx - 1));
            }
          }

          isSwiping = false;
        },
        { passive: true },
      );
    });
  }

  if (typeof window !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initProjectGalleries);
    } else {
      initProjectGalleries();
    }
    document.addEventListener("astro:page-load", initProjectGalleries);
    window.addEventListener("feed-view-change", () => {
      setTimeout(initProjectGalleries, 50);
    });

    import("@barba/core")
      .then((m) => {
        m.default?.hooks?.after(initProjectGalleries);
      })
      .catch(() => {});
  }
</script>
