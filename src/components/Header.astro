</style>

<script>
  import { initAudioPlayer } from "../scripts/audio";

  function setupNav() {
    const navPills = document.querySelectorAll<HTMLAnchorElement>("#main-nav a.nav-pill");
    const brandLink = document.getElementById("brand-link");
    const mobileBrandLogo = document.getElementById("mobile-brand-logo");
    const mobileMenuLabel = document.getElementById("mobile-menu-label");
    const mobileMenuBrandLink = document.getElementById("mobile-menu-brand-link");
    const switcher = document.getElementById("column-switcher");

    const mobileMenuOverlay = document.getElementById("mobile-menu-overlay");
    const mobileMenuTrigger = document.getElementById("mobile-menu-trigger");
    const mobileMenuCloseBtn = document.getElementById("mobile-menu-close-btn");
    const mobilePageLabel = document.getElementById("mobile-page-label");
    const mobileColBtn = document.getElementById("mobile-col-toggle");
    const mobileNavItems = document.querySelectorAll<HTMLAnchorElement>(".mobile-nav-item");
    const journalFiltersDesktop = document.getElementById("journal-filters-desktop");
    const mobileFilterBtn = document.getElementById("mobile-journal-filter-btn");
    const mobileFilterDrawer = document.getElementById("mobile-journal-filter-drawer");
    const allFilterPills = document.querySelectorAll<HTMLButtonElement>(".journal-filter-pill");

    function setMobileFilterDrawer(open: boolean) {
      if (!mobileFilterBtn || !mobileFilterDrawer) return;
      if (open) {
        mobileFilterDrawer.classList.add("is-open");
        mobileFilterDrawer.setAttribute("aria-hidden", "false");
        mobileFilterBtn.textContent = "Close";
        mobileFilterBtn.setAttribute("aria-expanded", "true");
      } else {
        mobileFilterDrawer.classList.remove("is-open");
        mobileFilterDrawer.setAttribute("aria-hidden", "true");
        mobileFilterBtn.textContent = "Filter";
        mobileFilterBtn.setAttribute("aria-expanded", "false");
      }
    }

    if (mobileFilterBtn && mobileFilterDrawer) {
      mobileFilterBtn.addEventListener("click", () => {
        const isOpen = mobileFilterDrawer.classList.contains("is-open");
        setMobileFilterDrawer(!isOpen);
      });
    }

    const selectedCategories = new Set<string>();

    function applyJournalFilterUI(categories: string[] = []) {
      selectedCategories.clear();
      categories.forEach((c) => {
        if (c && c !== "All") selectedCategories.add(c);
      });

      const isAll = selectedCategories.size === 0;
      allFilterPills.forEach((pill) => {
        const filterVal = pill.dataset.filter || "";
        if (filterVal === "All") {
          pill.classList.toggle("is-active", isAll);
        } else {
          pill.classList.toggle("is-active", selectedCategories.has(filterVal));
        }
      });
    }

    allFilterPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const category = pill.dataset.filter || "All";
        if (category === "All") {
          selectedCategories.clear();
        } else if (selectedCategories.has(category)) {
          selectedCategories.delete(category);
        } else {
          selectedCategories.add(category);
        }

        const nextCategories = Array.from(selectedCategories);
        applyJournalFilterUI(nextCategories);
        window.dispatchEvent(new CustomEvent("journal-filter-change", { detail: { categories: nextCategories } }));
      });
    });

    (window as any).syncJournalFilterState = applyJournalFilterUI;
    (window as any).closeMobileJournalFilter = () => setMobileFilterDrawer(false);

    function openMobileMenu() {
      if (mobileMenuOverlay) {
        mobileMenuOverlay.classList.add("is-open");
        mobileMenuOverlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }
    }

    function closeMobileMenu() {
      if (mobileMenuOverlay) {
        mobileMenuOverlay.classList.remove("is-open");
        mobileMenuOverlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }
    }

    if (mobileMenuTrigger) {
      mobileMenuTrigger.addEventListener("click", openMobileMenu);
    }

    if (mobileMenuCloseBtn) {
      mobileMenuCloseBtn.addEventListener("click", closeMobileMenu);
    }

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeMobileMenu();
      }
    });

    const routeLabels: Record<string, string> = {
      "/": "Approach",
      "/approach": "Approach",
      "/studio": "Studio",
      "/journal": "Journal",
      "/inquire": "Inquire",
    };

    function normalizePath(rawPath: string): string {
      const clean = rawPath.split("?")[0].split("#")[0].replace(/\/+$/, "");
      return clean || "/";
    }

    function applyActiveState(pathname: string) {
      const norm = normalizePath(pathname);
      const activePath = norm === "/" ? "/approach" : norm;

      navPills.forEach((pill) => {
        const href = normalizePath(pill.getAttribute("href") || "");
        if (href && (activePath === href || (href !== "/" && activePath.startsWith(href + "/")))) {
          pill.classList.add("is-active");
        } else {
          pill.classList.remove("is-active");
        }
      });

      if (switcher) {
        if (norm === "/") {
          switcher.classList.remove("is-hidden");
        } else {
          switcher.classList.add("is-hidden");
        }
      }

      if (mobilePageLabel) {
        mobilePageLabel.textContent = routeLabels[norm] || routeLabels[activePath] || "Approach";
      }

      mobileNavItems.forEach((item) => {
        const href = normalizePath(item.getAttribute("href") || "");
        if (href && (activePath === href || (href !== "/" && activePath.startsWith(href + "/")))) {
          item.classList.add("is-active");
        } else {
          item.classList.remove("is-active");
        }
      });

      if (mobileColBtn) {
        if (norm === "/") {
          mobileColBtn.classList.remove("is-hidden");
        } else {
          mobileColBtn.classList.add("is-hidden");
        }
      }

      if (mobileBrandLogo && mobileMenuLabel) {
        if (norm === "/") {
          mobileBrandLogo.classList.remove("is-hidden");
          mobileMenuLabel.classList.add("is-hidden");
        } else {
          mobileBrandLogo.classList.add("is-hidden");
          mobileMenuLabel.classList.remove("is-hidden");
        }
      }

      const isJournal = activePath === "/journal" || activePath.startsWith("/journal/");
      if (journalFiltersDesktop) {
        if (isJournal) {
          journalFiltersDesktop.classList.remove("is-hidden");
        } else {
          journalFiltersDesktop.classList.add("is-hidden");
        }
      }

      if (mobileFilterBtn) {
        if (isJournal) {
          mobileFilterBtn.classList.remove("is-hidden");
        } else {
          mobileFilterBtn.classList.add("is-hidden");
          setMobileFilterDrawer(false);
        }
      }
    }

    navPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const href = pill.getAttribute("href") || "/";
        applyActiveState(href);
      });
    });

    mobileNavItems.forEach((item) => {
      item.addEventListener("click", () => {
        closeMobileMenu();
        const href = item.getAttribute("href") || "/";
        applyActiveState(href);
      });
    });

    if (brandLink) {
      brandLink.addEventListener("click", () => {
        applyActiveState("/");
      });
    }

    if (mobileMenuBrandLink) {
      mobileMenuBrandLink.addEventListener("click", () => {
        closeMobileMenu();
        applyActiveState("/");
      });
    }

    const colButtons = document.querySelectorAll<HTMLButtonElement>("#column-switcher .col-btn");
    colButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const col = btn.getAttribute("data-col") || "1";
        colButtons.forEach((b) => {
          if (b.getAttribute("data-col") === col) {
            b.classList.add("is-active");
          } else {
            b.classList.remove("is-active");
          }
        });
        window.dispatchEvent(new CustomEvent("feed-view-change", { detail: { mode: col === "8" ? "8" : "1" } }));
      });
    });

    if (mobileColBtn) {
      mobileColBtn.addEventListener("click", () => {
        const currentMode = mobileColBtn.textContent?.trim();
        const nextMode = currentMode === "3" ? "3" : "1";
        const buttonDisplay = nextMode === "3" ? "1" : "3";
        mobileColBtn.textContent = buttonDisplay;
        window.dispatchEvent(new CustomEvent("feed-view-change", { detail: { mode: nextMode } }));
      });
    }

    function syncSwitcherState(mode: string) {
      colButtons.forEach((b) => {
        if (b.getAttribute("data-col") === mode) {
          b.classList.add("is-active");
        } else {
          b.classList.remove("is-active");
        }
      });
      if (mobileColBtn) {
        mobileColBtn.textContent = mode === "3" || mode === "8" ? "1" : "3";
      }
    }
    (window as any).syncSwitcherState = syncSwitcherState;

    (window as any).syncNavState = applyActiveState;
    applyActiveState(window.location.pathname);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      setupNav();
      initAudioPlayer();
    });
  } else {
    setupNav();
    initAudioPlayer();
  }
</script>
