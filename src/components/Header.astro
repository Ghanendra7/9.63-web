      </a>
    </div>

    <div class="header-right">
      <nav class={`nav-bar ${hasAudio ? "" : "has-no-audio"}`} id="main-nav">
        {navItems.map((item) => {
          const isActive = activeHref === item.href || (item.href !== "/" && activeHref.startsWith(item.href + "/"));
          return (
            <a
              href={item.href}
              class={`nav-pill ${isActive ? "is-active" : ""}`}
              data-nav-key={item.key}
              aria-label={item.label}
            >
              <span class="nav-initial" aria-hidden="true">{item.initial}</span>
              <span class="nav-full">
                <span class="nav-bullet" aria-hidden="true" />
                <span class="nav-label">{item.label}</span>
              </span>
            </a>
          );
        })}

        <button
          type="button"
          class={`nav-pill nav-play-btn ${hasAudio ? "" : "is-hidden"}`}
          id="audio-toggle"
          aria-label={siteAudio ? `Play ${siteAudio.title}` : "Play audio"}
          aria-pressed="false"
        >
          <span class="audio-btn-inner">
            <span class="audio-title" id="audio-title">{siteAudio?.title || ""}</span>
            <span class="play-icon" aria-hidden="true" />
          </span>
        </button>
      </nav>

      <div class={`sub-bar column-switcher ${isHomePage ? "" : "is-hidden"}`} id="column-switcher">
        <button type="button" class={`col-btn ${!isCol8 ? "is-active" : ""}`} data-col="1" aria-label="1 Column view">
          1
        </button>
        <button type="button" class={`col-btn ${isCol8 ? "is-active" : ""}`} data-col="8" aria-label="8 Column view">
          8
        </button>
      </div>

      <div class={`journal-filters-desktop ${isJournalPage ? "" : "is-hidden"}`} id="journal-filters-desktop" aria-label="Journal Category Filters">
        <div class="journal-filter-wrap">
          <button
            type="button"
            class="journal-filter-pill is-all is-active"
            data-filter="All"
          >
            <span class="filter-dot" aria-hidden="true" />
            <span>All</span>
          </button>
          {JOURNAL_CATEGORIES.map((cat) => (
            <button
              type="button"
              class="journal-filter-pill"
              data-filter={cat}
            >
              <span>{cat}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="mobile-header mobile-only">
    <div class="mobile-left">
      <button type="button" class="mobile-brand-pill" id="mobile-menu-trigger" aria-label="Open Navigation Menu">
        <span class="mobile-dot" aria-hidden="true" />
        <img
          src="/brand-logo-compact.svg"
          alt="9.63"
          class={`mobile-brand-logo ${isHomePage ? "" : "is-hidden"}`}
          id="mobile-brand-logo"
        />
        <span class={`mobile-menu-label ${isHomePage ? "is-hidden" : ""}`} id="mobile-menu-label">
          Menu
        </span>
      </button>
    </div>

    <div class="mobile-center">
      <div class="mobile-page-pill">
        <span class="mobile-page-label" id="mobile-page-label">{activeLabel}</span>
      </div>
    </div>

    <div class="mobile-right">
      <button
        type="button"
        class={`mobile-filter-btn ${isJournalPage ? "" : "is-hidden"}`}
        id="mobile-journal-filter-btn"
        aria-expanded="false"
        aria-controls="mobile-journal-filter-drawer"
      >
        Filter
      </button>
      <button
        type="button"
        class={`nav-pill nav-play-btn mobile-play-btn ${hasAudio ? "" : "is-hidden"}`}
        id="mobile-audio-toggle"
        aria-label={siteAudio ? `Play ${siteAudio.title}` : "Play audio"}
        aria-pressed="false"
      >
        <span class="play-icon" aria-hidden="true" />
      </button>
      <button type="button" class={`mobile-col-btn ${isHomePage ? "" : "is-hidden"}`} id="mobile-col-toggle" aria-label="Toggle Column View">
        {isCol3 ? "1" : "3"}
      </button>
    </div>
  </div>

  <div class="mobile-journal-filter-drawer mobile-only" id="mobile-journal-filter-drawer" aria-hidden="true">
    <button
      type="button"
      class="journal-filter-pill mobile-all-pill is-all is-active"
      data-filter="All"
    >
      <span class="filter-dot" aria-hidden="true" />
      <span>All</span>
    </button>
    <div class="mobile-filter-chips">
      {JOURNAL_CATEGORIES.map((cat) => (
        <button
          type="button"
          class="journal-filter-pill is-mobile-chip"
          data-filter={cat}
        >
          <span>{cat}</span>
        </button>
      ))}
    </div>
  </div>
</header>

