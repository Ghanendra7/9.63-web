</div>

<style>
  .site-header {
    position: fixed;
    top: var(--header-top);
    left: 0;
    right: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .desktop-only {
    display: grid;
  }

  .mobile-only {
    display: none;
  }

  .header-inner {
    max-width: calc(var(--max-content-width) + (var(--page-margin) * 2));
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--page-margin);
    padding-right: var(--page-margin);
    grid-template-columns: 1fr 1fr;
    gap: 0px;
    align-items: flex-start;
  }

  .header-left,
  .header-right {
    pointer-events: auto;
  }

  .brand-pill {
    height: var(--header-height);
    background-color: var(--color-pill-light);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-radius: var(--radius-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    width: 100%;
    transition: background-color 0.3s ease;
  }

  .brand-pill:hover {
    background-color: var(--color-pill-frame);
  }

  .brand-logo {
    width: 100%;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo svg {
    height: 14px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .brand-logo svg.brand-dot-svg {
    height: 3.5px;
  }

  .header-right {
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--header-height);
    position: relative;
    gap: 0;
  }

  .nav-pill {
    height: var(--header-height);
    flex: 0 0 var(--header-height);
    width: var(--header-height);
    min-width: var(--header-height);
    border-radius: var(--radius-pill);
    background-color: var(--color-pill-light);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-primary);
    border: none;
    cursor: pointer;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    padding: 0;
    transition:
      flex-basis var(--nav-expand-duration) var(--ease-nav),
      width var(--nav-expand-duration) var(--ease-nav),
      background-color 0.25s ease;
  }

  .nav-pill:hover:not(.is-active):not(.nav-play-btn) {
    flex: 0 0 95px;
    width: 95px;
    background-color: var(--color-pill-frame);
    transition:
      flex-basis var(--nav-hover-duration) var(--ease-nav),
      width var(--nav-hover-duration) var(--ease-nav),
      background-color 0.25s ease;
  }

  .nav-pill.is-active {
    flex: 0 1 calc(100% - 120px);
    width: calc(100% - 120px);
    min-width: var(--header-height);
    background-color: var(--color-pill-active);
    transition:
      flex-basis var(--nav-expand-duration) var(--ease-nav),
      width var(--nav-expand-duration) var(--ease-nav),
      background-color 0.3s ease;
  }

  .nav-bar.has-no-audio .nav-pill.is-active {
    flex-basis: calc(100% - 90px);
    width: calc(100% - 90px);
  }

  .nav-initial {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 1;
    line-height: 1;
    pointer-events: none;
    transition: opacity calc(var(--nav-hover-duration) * 0.5) ease;
  }

  .nav-pill:hover .nav-initial,
  .nav-pill.is-active .nav-initial {
    opacity: 0;
  }

  .nav-full {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    padding: 0 14px;
    opacity: 0;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity calc(var(--nav-hover-duration) * 0.7) var(--ease-nav) calc(var(--nav-hover-duration) * 0.2);
  }

  .nav-pill:hover .nav-full {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-pill.is-active .nav-full {
    opacity: 1;
    pointer-events: auto;
    transition: opacity calc(var(--nav-expand-duration) * 0.6) var(--ease-nav) calc(var(--nav-expand-duration) * 0.2);
  }

  .nav-bullet {
    display: none;
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 50%;
    background-color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .nav-pill.is-active .nav-bullet {
    display: block;
  }

  .nav-label {
    white-space: nowrap;
  }

  .nav-play-btn {
    flex: 0 0 30px;
    width: 30px;
    min-width: 30px;
    margin-left: auto;
    justify-content: flex-end;
    padding: 0 9.75px 0 0;
  }

  .nav-play-btn.is-hidden {
    display: none;
  }

  .nav-play-btn:hover,
  .nav-play-btn.is-playing {
    flex: 0 0 var(--audio-expanded-width, auto);
    width: var(--audio-expanded-width, auto);
    max-width: calc(100% - 190px);
    padding-left: 14px;
    background-color: var(--color-pill-active);
    transition:
      flex-basis var(--nav-expand-duration) var(--ease-nav),
      width var(--nav-expand-duration) var(--ease-nav),
      background-color 0.25s ease;
  }

  .nav-play-btn:hover {
    background-color: var(--color-pill-frame);
    transition:
      flex-basis var(--nav-hover-duration) var(--ease-nav),
      width var(--nav-hover-duration) var(--ease-nav),
      background-color 0.25s ease;
  }

  .audio-btn-inner {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    width: 100%;
    min-width: 0;
    height: 100%;
    pointer-events: none;
  }

  .play-icon {
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 50%;
    background-color: #828282;
    flex-shrink: 0;
    pointer-events: none;
    transition: background-color 0.25s ease;
  }

  .nav-play-btn:hover:not(.is-playing) .play-icon {
    background-color: var(--color-text-primary);
  }

  .audio-title {
    min-width: 0;
    flex: 1 1 auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    pointer-events: none;
    line-height: 1;
    color: var(--color-gris-03);
    transition: opacity 0.15s ease;
  }

  .nav-play-btn.is-playing .play-icon {
    background-color: var(--color-red);
  }

  .nav-play-btn:hover .audio-title,
  .nav-play-btn.is-playing .audio-title {
    opacity: 1;
    transition: opacity calc(var(--nav-hover-duration) * 0.7) var(--ease-nav) calc(var(--nav-hover-duration) * 0.15);
  }

  .nav-play-btn.is-playing .audio-title {
    transition: opacity calc(var(--nav-expand-duration) * 0.6) var(--ease-nav) calc(var(--nav-expand-duration) * 0.12);
  }

  .mobile-play-btn {
    margin-left: 0;
    justify-content: center;
    padding: 0;
  }

  .mobile-play-btn:hover,
  .mobile-play-btn.is-playing {
    flex: 0 0 30px;
    width: 30px;
    max-width: 30px;
    padding: 0;
    background-color: var(--color-pill-light);
  }

  .sub-bar {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .column-switcher {
    display: flex;
    align-items: center;
    width: 100%;
    transition: opacity 0.3s ease, transform 0.3s var(--ease-nav);
  }

  .column-switcher.is-hidden,
  .journal-filters-desktop.is-hidden {
    display: none;
    opacity: 0;
    pointer-events: none;
  }

  .journal-filters-desktop {
    display: flex;
    flex-direction: column;
    gap: 4px;
