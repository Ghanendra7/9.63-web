      <button type="button" class="mobile-menu-close-btn" id="mobile-menu-close-btn" aria-label="Close Menu">
        Close
      </button>
    </div>

    <nav class="mobile-menu-nav">
      {mobileNavItems.map((item) => {
        const isActive = activeHref === item.href || (item.href !== "/" && activeHref.startsWith(item.href + "/"));
        return (
          <a
            href={item.href}
            class={`mobile-nav-item ${isActive ? "is-active" : ""}`}
            data-nav-key={item.key}
          >
            <span class="mobile-item-label">{item.label}</span>
          </a>
        );
      })}
    </nav>

    <div class="mobile-menu-footer">
      <p class="mobile-tagline">
        We unite design thinking and intuition to build worlds for forward-moving brands.
      </p>
    </div>
