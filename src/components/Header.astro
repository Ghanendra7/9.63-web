---
import { JOURNAL_CATEGORIES } from "../types/journal";
import { getSiteAudio } from "../lib/audio";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const siteAudio = await getSiteAudio();
const hasAudio = Boolean(siteAudio?.url);

const navItems = [
  { href: "/approach", label: "Approach", initial: "A", key: "approach" },
  { href: "/studio", label: "Studio", initial: "S", key: "studio" },
  { href: "/journal", label: "Journal", initial: "J", key: "journal" },
  { href: "/inquire", label: "Inquire", initial: "I", key: "inquire" },
];

const mobileNavItems = [
  { href: "/approach", label: "Approach", key: "approach" },
  { href: "/inquire", label: "Inquire", key: "inquire" },
  { href: "/journal", label: "Journal", key: "journal" },
  { href: "/studio", label: "Studio", key: "studio" },
];

const activeHref = currentPath === "/" || currentPath === "" ? "/approach" : currentPath;
const activeItem = navItems.find((item) => activeHref === item.href || (item.href !== "/" && activeHref.startsWith(item.href + "/"))) || navItems[0];
const activeLabel = activeItem.label;
const isHomePage = currentPath === "/" || currentPath === "";
const isJournalPage = activeHref === "/journal" || activeHref.startsWith("/journal/");

const initialColView = Astro.url.searchParams.get("view") || "1";
const isCol8 = initialColView === "8";
const isCol3 = initialColView === "3";
