---
interface Props {
  currentPath?: string;
  namespace?: string;
}

const { currentPath = Astro.url.pathname, namespace = "home" } = Astro.props;

const navItems = [
  { href: "/approach", label: "Approach", initial: "A", key: "approach" },
  { href: "/studio", label: "Studio", initial: "S", key: "studio" },
  { href: "/journal", label: "Journal", initial: "J", key: "journal" },
  { href: "/inquire", label: "Inquire", initial: "I", key: "inquire" },
];
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="brand-pill" id="brand-link" aria-label="9.63 Home">
        <img src="/brand-logo.svg" alt="9 . 6 3" class="brand-logo" />
      </a>
    </div>

    <div class="header-right">
      <nav class="nav-bar" id="main-nav">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href + "/"));
          return (
            <a
              href={item.href}
              class={`nav-pill ${isActive ? "is-active" : ""}`}
              data-nav-key={item.key}
              aria-label={item.label}
            >
              <span class="nav-initial-label" aria-hidden="true">{item.initial}</span>
              <span class="nav-expanded-content">
                <span class="nav-bullet" aria-hidden="true" />
                <span class="nav-full-label">{item.label}</span>
              </span>
            </a>
          );
        })}

        <button type="button" class="nav-pill nav-play-btn" id="audio-toggle" aria-label="Toggle Music Player">
          <span class="play-icon" />
        </button>
      </nav>

      <div class="sub-bar column-switcher" id="column-switcher" style={namespace === "home" ? "display: flex;" : "display: none;"}>
        <button type="button" class="col-btn is-active" data-col="1" aria-label="1 Column view">
          1
        </button>
        <button type="button" class="col-btn" data-col="8" aria-label="8 Column view">
          8
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: var(--header-top);
    left: 0;
    right: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .header-inner {
    max-width: calc(var(--max-content-width) + (var(--page-margin) * 2));
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--page-margin);
    padding-right: var(--page-margin);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gutter);
    align-items: flex-start;
  }

  .header-left,
  .header-right {
    pointer-events: auto;
  }

  .brand-pill {
    height: var(--header-height);
    background-color: var(--color-pill-light);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-radius: var(--radius-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    width: 100%;
    transition: background-color 0.3s ease;
  }

  .brand-pill:hover {
    background-color: var(--color-pill-frame);
  }

  .brand-logo {
    width: 100%;
    max-width: 802px;
    height: 14px;
    object-fit: contain;
  }

  .header-right {
    display: flex;
    flex-direction: column;
    gap: 5px;
    position: relative;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--header-height);
    position: relative;
  }

  .nav-pill {
    height: var(--header-height);
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 30px;
    min-width: 30px;
    border-radius: var(--radius-pill);
    background-color: var(--color-pill-light);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-primary);
    border: none;
    cursor: pointer;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    padding: 0;
    transition:
      flex-grow 0.65s cubic-bezier(0.25, 1, 0.3, 1),
      min-width 0.65s cubic-bezier(0.25, 1, 0.3, 1),
      background-color 0.3s ease;
  }

  .nav-pill:hover:not(.is-active) {
    background-color: var(--color-pill-frame);
  }

  .nav-pill.is-active {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    background-color: var(--color-pill-active);
  }

  .nav-initial-label {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 1;
    line-height: 1;
    pointer-events: none;
    transition:
      opacity 0.25s cubic-bezier(0.25, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.25, 1, 0.3, 1);
  }

  .nav-pill.is-active .nav-initial-label {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
  }

  .nav-expanded-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    padding: 0 16px;
    opacity: 0;
    transform: scale(0.9);
    white-space: nowrap;
    pointer-events: none;
    transition:
      opacity 0.4s cubic-bezier(0.25, 1, 0.3, 1) 0.12s,
      transform 0.5s cubic-bezier(0.25, 1, 0.3, 1) 0.12s;
  }

  .nav-pill.is-active .nav-expanded-content {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .nav-bullet {
    width: 10.5px;
    height: 10.5px;
    border-radius: 50%;
    background-color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .nav-full-label {
    white-space: nowrap;
  }

  .nav-play-btn {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 30px;
    width: 30px;
    margin-left: auto;
  }

  .play-icon {
    width: 10.5px;
    height: 10.5px;
    border-radius: 50%;
    background-color: #828282;
    transition: transform 0.3s ease;
  }

  .nav-play-btn:hover .play-icon {
    transform: scale(1.15);
  }

  .sub-bar {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .column-switcher {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .col-btn {
    height: var(--header-height);
    border-radius: var(--radius-pill);
    background-color: var(--color-pill-light);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: none;
    cursor: pointer;
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      flex-grow 0.5s cubic-bezier(0.25, 1, 0.3, 1),
      background-color 0.25s ease;
  }

  .col-btn:not(.is-active) {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 30px;
    width: 30px;
  }

  .col-btn.is-active {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: var(--color-pill-active);
  }

  @media (max-width: 768px) {
    .header-inner {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .brand-logo {
      height: 12px;
    }
  }
</style>

<script>
  function setupNavHandlers() {
    const navPills = document.querySelectorAll<HTMLAnchorElement>("#main-nav a.nav-pill");
    const brandLink = document.getElementById("brand-link");
    const switcher = document.getElementById("column-switcher");

    function applyActiveState(pathname: string) {
      navPills.forEach((pill) => {
        const href = pill.getAttribute("href");
        if (href && (pathname === href || (href !== "/" && pathname.startsWith(href)))) {
          pill.classList.add("is-active");
        } else {
          pill.classList.remove("is-active");
        }
      });

      if (switcher) {
        if (pathname === "/" || pathname === "") {
          switcher.style.display = "flex";
        } else {
          switcher.style.display = "none";
        }
      }
    }

    navPills.forEach((pill) => {
      if (!pill.hasAttribute("data-bound")) {
        pill.setAttribute("data-bound", "true");
        pill.addEventListener("click", () => {
          const href = pill.getAttribute("href") || "/";
          applyActiveState(href);
        });
      }
    });

    if (brandLink && !brandLink.hasAttribute("data-bound")) {
      brandLink.setAttribute("data-bound", "true");
      brandLink.addEventListener("click", () => {
        applyActiveState("/");
      });
    }

    applyActiveState(window.location.pathname);
  }

  document.addEventListener("astro:page-load", setupNavHandlers);
</script>
