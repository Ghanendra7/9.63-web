---
import type { Project } from "../types/project";
import { urlFor } from "../lib/sanity";

interface Props {
  project: Project;
  index: number;
  desktopCol: number;
  desktopRow: number;
  mobileCol: number;
  mobileRow: number;
}

const { project, index, desktopCol, desktopRow, mobileCol, mobileRow } =
  Astro.props;

const rawImages =
  project.images && project.images.length > 0
    ? project.images
    : [project.coverImage, ...(project.gallery || [])].filter(Boolean);

const firstImg = rawImages[0];
const hasAsset = Boolean(firstImg?.asset?._id || firstImg?.asset?._ref);
const coverUrl = hasAsset
  ? urlFor(firstImg).width(800).auto("format").url()
  : firstImg?.asset?.url || `/placeholders/pd${(index % 8) + 1}.png`;

const focalX =
  firstImg?.hotspot?.x != null ? Math.round(firstImg.hotspot.x * 100) : 50;
const focalY =
  firstImg?.hotspot?.y != null ? Math.round(firstImg.hotspot.y * 100) : 50;
const objectPosition = `${focalX}% ${focalY}%`;

const projectOrder = index + 1;
const projectNum = String(projectOrder).padStart(2, "0");
const slug =
  (typeof project.slug === "object" ? project.slug?.current : project.slug) ||
  `project-${projectNum}`;
---

<article
  class="constellation-card"
  style={`--col-d: ${desktopCol}; --row-d: ${desktopRow}; --col-m: ${mobileCol}; --row-m: ${mobileRow};`}
  aria-label={`Project ${projectNum}: ${project.title}`}
>
  <div class="constellation-link">
    <div class="constellation-media">
      <img
        src={coverUrl}
        alt={firstImg?.alt || project.title}
        class="constellation-img primary-img"
        style={`object-position: ${objectPosition};`}
        loading="lazy"
        decoding="async"
      />

      <div class="constellation-overlay" aria-hidden="true">
        <div class="overlay-pill">
          <span class="overlay-num">{projectNum}</span>
          <span class="overlay-title">{project.title}</span>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .constellation-card {
    grid-column: var(--col-d);
    grid-row: var(--row-d);
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    overflow: hidden;
    position: relative;
    transition: opacity 0.35s var(--ease-nav);
  }

  .constellation-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .constellation-media {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: rgba(240, 240, 240, 0.4);
  }

  .constellation-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-card);
    transition: opacity 0.35s var(--ease-nav);
  }

  .primary-img {
    opacity: 1;
    z-index: 1;
  }

  .constellation-overlay {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: flex-end;
    padding: 8px;
    opacity: 0;
    transition: opacity 0.25s var(--ease-nav);
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.15), transparent 40%);
  }

  .constellation-card:hover .constellation-overlay {
    opacity: 1;
  }

  .overlay-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: var(--header-height);
    padding: 0 10px;
    border-radius: var(--radius-pill-sm);
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    max-width: 100%;
  }

  .overlay-num {
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-muted);
  }

  .overlay-title {
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .constellation-card {
      grid-column: var(--col-m);
      grid-row: var(--row-m);
    }
  }
</style>
