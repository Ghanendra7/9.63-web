---
import type { Project } from "../types/project";
import { urlFor } from "../lib/sanity";

interface Props {
  project: Project;
  index: number;
  desktopCol: number;
  desktopRow: number;
  mobileCol: number;
  mobileRow: number;
}

const { project, index, desktopCol, desktopRow, mobileCol, mobileRow } = Astro.props;

const coverUrl = project.coverImage?.asset?.url || (project.coverImage ? urlFor(project.coverImage).width(800).auto("format").url() : `/placeholders/pd${(index % 8) + 1}.png`);
const galleryUrl = project.gallery?.[0]?.asset?.url || (project.gallery?.[0] ? urlFor(project.gallery[0]).width(800).auto("format").url() : null);

const projectOrder = index + 1;
const projectNum = String(projectOrder).padStart(2, "0");
const slug = project.slug?.current || `project-${projectNum}`;
---

<article
  class="constellation-card"
  style={`--col-d: ${desktopCol}; --row-d: ${desktopRow}; --col-m: ${mobileCol}; --row-m: ${mobileRow};`}
  aria-label={`Project ${projectNum}: ${project.title}`}
>
  <a href={`/project/${slug}`} class="constellation-link" tabindex="0">
    <div class="constellation-media">
      <img
        src={coverUrl}
        alt={project.coverImage?.alt || project.title}
        class="constellation-img primary-img"
        loading="lazy"
        decoding="async"
      />
      {galleryUrl && (
        <img
          src={galleryUrl}
          alt={`${project.title} preview`}
          class="constellation-img secondary-img"
          loading="lazy"
          decoding="async"
        />
      )}

      {project.comingSoon && (
        <div class="constellation-soon" aria-hidden="true">
          <span>Coming Soon</span>
        </div>
      )}

      <div class="constellation-overlay" aria-hidden="true">
        <div class="overlay-pill">
          <span class="overlay-num">{projectNum}</span>
          <span class="overlay-title">{project.title}</span>
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  .constellation-card {
    grid-column: var(--col-d);
    grid-row: var(--row-d);
    width: 100%;
    aspect-ratio: 2500 / 3112;
    border-radius: var(--radius-card);
    overflow: hidden;
    position: relative;
    transition: transform 0.4s var(--ease-expo);
  }

  .constellation-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .constellation-media {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: rgba(240, 240, 240, 0.4);
  }

  .constellation-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-card);
    transition: opacity 0.35s var(--ease-nav), transform 0.6s var(--ease-expo);
  }

  .primary-img {
    opacity: 1;
    z-index: 1;
  }

  .secondary-img {
    opacity: 0;
    z-index: 2;
  }

  .constellation-card:hover {
    transform: translateY(-2px);
  }

  .constellation-card:hover .primary-img {
    transform: scale(1.04);
  }

  .constellation-card:hover .secondary-img {
    opacity: 1;
    transform: scale(1.04);
  }

  .constellation-soon {
    position: absolute;
    left: 6px;
    bottom: 6px;
    z-index: 3;
    height: 22px;
    padding: 0 8px;
    border-radius: 12px;
    background-color: var(--color-pill-frame);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .constellation-soon span {
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.5px;
    color: rgba(0, 0, 0, 0.35);
    white-space: nowrap;
  }

  .constellation-overlay {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: flex-end;
    padding: 8px;
    opacity: 0;
    transition: opacity 0.25s var(--ease-nav);
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.15), transparent 40%);
  }

  .constellation-card:hover .constellation-overlay {
    opacity: 1;
  }

  .overlay-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 8px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    max-width: 100%;
  }

  .overlay-num {
    font-size: 11px;
    color: var(--color-text-muted);
    line-height: 1;
  }

  .overlay-title {
    font-size: 11px;
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .constellation-card {
      grid-column: var(--col-m);
      grid-row: var(--row-m);
    }
  }
</style>
