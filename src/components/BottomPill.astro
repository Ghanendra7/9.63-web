---

<div class="bottom-pill-wrapper" id="bottom-pill">
  <div class="bottom-pill-inner">
    <form class="newsletter-form" onsubmit="event.preventDefault();">
      <label for="newsletter-input" class="newsletter-label">
        Subscribe to get the next issue in your inbox.
      </label>
      <input
        type="email"
        id="newsletter-input"
        class="newsletter-input"
        placeholder="your@email.com"
        aria-label="Email address"
        required
      />
      <button type="submit" class="newsletter-submit">
        Send
      </button>
    </form>
  </div>
</div>

<style>
  .bottom-pill-wrapper {
    position: fixed;
    bottom: 20px;
    left: 0;
    right: 0;
    z-index: 999;
    pointer-events: none;
  }

  .bottom-pill-inner {
    max-width: calc(var(--max-content-width) + (var(--page-margin) * 2));
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--page-margin);
    padding-right: var(--page-margin);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gutter);
  }

  .newsletter-form {
    grid-column: 2;
    pointer-events: auto;
    height: 34px;
    background-color: var(--color-pill-light);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px 0 14px;
    width: 100%;
    transition: background-color 0.2s var(--ease-expo);
  }

  .newsletter-label {
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
  }

  .newsletter-input {
    display: none;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-primary);
    font-size: var(--text-size);
    letter-spacing: var(--text-tracking);
    padding-left: 8px;
    flex: 1;
  }

  .newsletter-form.is-focused .newsletter-label {
    display: none;
  }

  .newsletter-form.is-focused .newsletter-input {
    display: block;
  }

  .newsletter-submit {
    height: 30px;
    padding: 0 24px;
    border-radius: var(--radius-pill-sm);
    background-color: var(--color-pill-active);
    color: var(--color-text-primary);
    font-size: var(--text-size);
    letter-spacing: var(--text-tracking);
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s var(--ease-expo), transform 0.15s var(--ease-expo);
    flex-shrink: 0;
  }

  .newsletter-submit:hover {
    background-color: rgba(130, 130, 130, 0.25);
  }

  .newsletter-submit:active {
    transform: scale(0.98);
  }

  @media (max-width: 768px) {
    .bottom-pill-inner {
      grid-template-columns: 1fr;
    }

    .newsletter-form {
      grid-column: 1;
    }

    .newsletter-label {
      font-size: 11px;
    }
  }
</style>

<script>
  function initNewsletter() {
    const form = document.querySelector(".newsletter-form");
    const label = document.querySelector(".newsletter-label");
    const input = document.getElementById("newsletter-input") as HTMLInputElement | null;

    if (form && label && input && !form.hasAttribute("data-bound")) {
      form.setAttribute("data-bound", "true");
      label.addEventListener("click", () => {
        form.classList.add("is-focused");
        input.focus();
      });

      input.addEventListener("blur", () => {
        if (!input.value) {
          form.classList.remove("is-focused");
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNewsletter);
  } else {
    initNewsletter();
  }
</script>
