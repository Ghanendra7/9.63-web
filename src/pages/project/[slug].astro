---
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../lib/projects";
import { urlFor } from "../../lib/sanity";
import type { Project } from "../../types/project";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.slug?.current || `project-${index + 1}` },
    props: {
      project,
      projectNumber: String(index + 1).padStart(2, "0"),
      slideCount: `${index + 1}/${projects.length}`,
    },
  }));
}

interface Props {
  project: Project;
  projectNumber: string;
  slideCount: string;
}

const { project, projectNumber, slideCount } = Astro.props;

const coverUrl = project.coverImage?.asset?.url || (project.coverImage ? urlFor(project.coverImage).width(1600).auto("format").url() : "/placeholders/pd1.png");
---

<Layout title={`${project.title} | 9.63`} namespace="project">
  <div class="project-page-container">
    <div class="project-header">
      <div class="project-meta-top">
        <span class="project-num-pill">{projectNumber}</span>
        <h1 class="project-title">{project.title}</h1>
        {project.client && <span class="project-client">{project.client}</span>}
      </div>
      <div class="project-meta-bottom">
        {project.year && <span class="meta-item">{project.year}</span>}
        <span class="meta-item">{slideCount}</span>
        {project.services && project.services.length > 0 && (
          <span class="meta-item">{project.services.join(", ")}</span>
        )}
      </div>
    </div>

    <div class="project-hero-media">
      <img src={coverUrl} alt={project.coverImage?.alt || project.title} class="hero-image" />
    </div>

    <div class="back-link-wrapper">
      <a href="/" class="back-pill">Back to overview</a>
    </div>
  </div>
</Layout>

<style>
  .project-page-container {
    width: 100%;
    min-height: 100dvh;
    padding-top: calc(var(--header-top) + var(--header-height) + 50px);
    padding-bottom: 80px;
    padding-left: var(--page-margin);
    padding-right: var(--page-margin);
    max-width: calc(var(--max-content-width) + (var(--page-margin) * 2));
    margin-left: auto;
    margin-right: auto;
  }

  .project-header {
    margin-bottom: 30px;
  }

  .project-meta-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .project-num-pill {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-pill-sm);
    background-color: var(--color-pill-frame);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-muted);
  }

  .project-title {
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: 0.54px;
    color: var(--color-text-primary);
    font-weight: normal;
  }

  .project-client {
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-muted);
  }

  .project-meta-bottom {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-muted);
  }

  .project-hero-media {
    width: 100%;
    max-width: 900px;
    aspect-ratio: 2500 / 3112;
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: rgba(240, 240, 240, 0.4);
    margin-bottom: 40px;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .back-link-wrapper {
    display: flex;
  }

  .back-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--header-height);
    padding: 0 16px;
    border-radius: var(--radius-pill);
    background-color: var(--color-pill-frame);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    color: var(--color-text-primary);
    text-decoration: none;
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    transition: background-color 0.2s ease;
  }

  .back-pill:hover {
    background-color: var(--color-pill-active);
  }
</style>
