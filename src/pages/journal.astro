---
import Layout from "../layouts/Layout.astro";
import JournalCard from "../components/JournalCard.astro";
import EditorialFooter from "../components/EditorialFooter.astro";
import { getJournals } from "../lib/journals";

const journals = await getJournals();
---

<Layout title="9.63 | Journal" namespace="journal">
  <div class="journal-container" id="journal-page-root">
    <section class="journal-feed" id="journal-feed" aria-label="Journal Entries">
      {journals.map((entry, index) => (
        <JournalCard
          entry={entry}
          index={index}
        />
      ))}
    </section>

    <p class="journal-empty is-hidden" id="journal-empty-state">
      No entries in this category yet.
    </p>

    <div class="journal-footer-wrapper">
      <EditorialFooter />
    </div>
  </div>
</Layout>

<style>
  .journal-container {
    width: 100%;
    min-height: 100dvh;
    padding-top: 188px;
    padding-bottom: var(--pad);
    padding-left: var(--pad);
    padding-right: var(--pad);
    max-width: calc(var(--max-content-width) + (var(--pad) * 2));
    margin-left: auto;
    margin-right: auto;
  }

  .journal-feed {
    display: flex;
    flex-direction: column;
    gap: 100px;
    width: 100%;
  }

  .journal-empty {
    font-size: var(--text-size);
    line-height: var(--text-leading);
    letter-spacing: var(--text-tracking);
    color: var(--color-text-muted);
    padding: 40px 0;
  }

  .journal-empty.is-hidden {
    display: none;
  }

  .journal-footer-wrapper {
    width: 100%;
    margin-top: 200px;
  }

  @media (max-width: 768px) {
    .journal-container {
      padding-top: 62px;
    }

    .journal-feed {
      gap: 40px;
    }

    .journal-footer-wrapper {
      margin-top: 100px;
    }
  }
</style>

<script>
  import { initJournalPage } from "../scripts/journalPage";

  if (typeof window !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initJournalPage);
    } else {
      initJournalPage();
    }
    document.addEventListener("astro:page-load", initJournalPage);
  }
</script>
