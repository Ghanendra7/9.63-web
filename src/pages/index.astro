---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ConstellationCard from "../components/ConstellationCard.astro";
import EditorialFooter from "../components/EditorialFooter.astro";
import { getProjects } from "../lib/projects";

const projects = await getProjects();

const initialView = Astro.url.searchParams.get("view") || "1";
const isInitialMulti = initialView === "8" || initialView === "3";

const DESKTOP_SLOTS = [
  { col: 2, row: 1 },
  { col: 5, row: 1 },
  { col: 1, row: 2 },
  { col: 8, row: 2 },
  { col: 3, row: 3 },
  { col: 7, row: 3 },
  { col: 8, row: 3 },
  { col: 9, row: 3 },
  { col: 1, row: 4 },
  { col: 6, row: 4 },
  { col: 3, row: 5 },
  { col: 9, row: 5 },
  { col: 2, row: 6 },
  { col: 8, row: 6 },
];

const MOBILE_SLOTS = [
  { col: 2, row: 1 },
  { col: 1, row: 2 },
  { col: 2, row: 2 },
  { col: 3, row: 3 },
  { col: 1, row: 4 },
  { col: 2, row: 4 },
  { col: 3, row: 4 },
  { col: 2, row: 5 },
  { col: 1, row: 6 },
  { col: 3, row: 6 },
  { col: 2, row: 7 },
  { col: 1, row: 8 },
  { col: 2, row: 8 },
  { col: 3, row: 8 },
  { col: 2, row: 9 },
  { col: 1, row: 10 },
];
---

<Layout title="9.63" namespace="home">
  <div class="home-container" id="home-feed-root">
    <section
      class={`feed-1col ${!isInitialMulti ? "is-active" : "is-hidden"}`}
      id="feed-1col"
      aria-label="1 Column Project Feed"
    >
      <div class="feed-1col-inner">
        {projects.map((project, index) => (
          <ProjectCard
            project={project}
            index={index}
            totalProjects={projects.length}
          />
        ))}
      </div>
    </section>

    <section
      class={`feed-constellation ${isInitialMulti ? "is-active" : "is-hidden"}`}
      id="feed-constellation"
      aria-label="Constellation Project Grid"
    >
      <div class="constellation-grid" id="constellation-grid">
        {projects.map((project, index) => {
          const dSlot = DESKTOP_SLOTS[index % DESKTOP_SLOTS.length];
          const mSlot = MOBILE_SLOTS[index % MOBILE_SLOTS.length];
          const dCycle = Math.floor(index / DESKTOP_SLOTS.length);
          const mCycle = Math.floor(index / MOBILE_SLOTS.length);
          return (
            <ConstellationCard
              project={project}
              index={index}
              desktopCol={dSlot.col}
              desktopRow={dSlot.row + dCycle * 6}
              mobileCol={mSlot.col}
              mobileRow={mSlot.row + mCycle * 10}
            />
          );
        })}
      </div>
    </section>

    <div class="feed-footer-wrapper">
      <EditorialFooter projects={projects} />
    </div>
  </div>
</Layout>

<style>
  .home-container {
    width: 100%;
    min-height: 100dvh;
    padding-bottom: var(--pad);
    padding-left: var(--pad);
    padding-right: var(--pad);
    max-width: calc(var(--max-content-width) + (var(--pad) * 2));
    margin-left: auto;
    margin-right: auto;
  }

  .feed-1col {
    width: 100%;
    display: flex;
    justify-content: center;
    transition: opacity 0.3s var(--ease-nav);
  }

  .feed-1col-inner {
    max-width: 834px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .feed-constellation {
    width: 100%;
    transition: opacity 0.3s var(--ease-nav);
  }

  .constellation-grid {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 2px;
    padding-top: 130px;
    width: 100%;
  }

  @media (hover: hover) {
    .constellation-grid:has(:global(.constellation-card:hover))
      :global(.constellation-card) {
      opacity: 0.2;
    }

    .constellation-grid:has(:global(.constellation-card:hover))
      :global(.constellation-card:hover) {
      opacity: 1;
    }
  }

  .feed-footer-wrapper {
    width: 100%;
  }

  .is-hidden {
    display: none !important;
    opacity: 0;
  }

  .is-active {
    display: block !important;
    opacity: 1;
  }

  @media (max-width: 768px) {
    .constellation-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3px;
      padding-top: 2px;
    }

    .feed-1col-inner {
      max-width: 100%;
      padding-top: 48px;
    }
  }
</style>

<script>
  import { initFeedViewSwitcher } from "../scripts/feedViewSwitcher";

  if (typeof window !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initFeedViewSwitcher);
    } else {
      initFeedViewSwitcher();
    }
    document.addEventListener("astro:page-load", initFeedViewSwitcher);
  }
</script>
