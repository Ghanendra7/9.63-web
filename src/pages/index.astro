---
import Layout from "../layouts/Layout.astro";
---

<Layout title="9.63 — Studio" namespace="home">
  <div class="page-container home-feed">
    <div class="placeholder-hero">
      <span class="sub-label">Home Feed (1 / 8 Column Mode)</span>
    </div>
  </div>
</Layout>

<style>
  .home-feed {
    min-height: 100dvh;
    padding-top: calc(var(--header-top) + var(--header-height) + 60px);
    padding-bottom: 80px;
  }

  .placeholder-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }

  .sub-label {
    font-size: var(--text-size);
    color: var(--color-text-muted);
    letter-spacing: var(--text-tracking);
  }
</style>
